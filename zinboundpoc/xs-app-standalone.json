{
  "welcomeFile": "/index.html",
  "authenticationMethod": "none",
  "sessionTimeout": 30,
  "routes": [
    {
      "source": "^/sap/opu/odata/(.*)$",
      "target": "/sap/opu/odata/$1",
      "destination": "zinbound-odata",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "dist",
      "authenticationType": "none"
    }
  ]
}
